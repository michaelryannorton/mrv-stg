APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Staging and production send through Postmark (MAIL_MAILER=postmark); each copy has its own Postmark server token.
POSTMARK_TOKEN=

# Secure session cookie; true on every copy served over https.
SESSION_SECURE_COOKIE=

# Invite-only gate (App\Http\Middleware\InviteOnlyGate): true sends signed-out visitors to /login with a noindex header.
STAGING_INVITE_ONLY=false

# Read-only weather database used by the data pages and /data/v1 (config/database.php 'weather').
# Locally a SQLite file; on a server WEATHER_DB_DRIVER=mysql with a SELECT-only user.
# Left commented so an unset name keeps the default (database/weather.sqlite).
# WEATHER_DB_DRIVER=mysql
# WEATHER_DB_DATABASE=
# WEATHER_DB_HOST=localhost
# WEATHER_DB_PORT=3306
# WEATHER_DB_USERNAME=
# WEATHER_DB_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Status dashboard health endpoint (route /_status/health; see config/services.php 'status_health').
# Names only here; each copy's real values are set in that copy's own .env.
STATUS_HEALTH_TOKEN_HASH=
STATUS_HEALTH_TOKEN_HASH_NEXT=
STATUS_HEALTH_PROPERTY=
STATUS_HEALTH_ENVIRONMENT=
STATUS_HEALTH_PHP_VERSION=
STATUS_HEALTH_DATABASE=true
STATUS_HEALTH_DB_CONNECTIONS=
STATUS_HEALTH_SCHEDULER=false
STATUS_HEALTH_QUEUE=false
STATUS_HEALTH_DISABLED_GROUPS=
STATUS_HEALTH_STATUS_DIR=
STATUS_HEALTH_HEARTBEAT_INGEST_ICS=
